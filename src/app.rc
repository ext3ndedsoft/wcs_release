#include <windows.h>
#include "resource.h"
#include "app_version.h"

IDI_APP_ICON ICON "app_icon.ico"
IDR_RESOURCES_BUNDLE RCDATA "resources.pak"


VS_VERSION_INFO VERSIONINFO
FILEVERSION     WCS_VERSION_MAJOR,WCS_VERSION_MINOR,WCS_VERSION_PATCH,WCS_VERSION_BUILD
PRODUCTVERSION  WCS_VERSION_MAJOR,WCS_VERSION_MINOR,WCS_VERSION_PATCH,WCS_VERSION_BUILD
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Windows Config Studio Team"
            VALUE "FileDescription",  "Windows Config Studio (WCS)"
            VALUE "FileVersion",      WCS_VERSION_STR
            VALUE "InternalName",     "WCS"
            VALUE "LegalCopyright",   "Open Source (MIT License)"
            VALUE "OriginalFilename", "WCS.exe"
            VALUE "ProductName",      "Windows Config Studio (WCS)"
            VALUE "ProductVersion",   WCS_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
